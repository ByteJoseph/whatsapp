    const-string v7, "\n          SELECT\n            acp1_message._id\n          FROM\n            message_limit_sharing_setting AS acp1\n            INNER JOIN message AS acp1_message\n              ON acp1.message_row_id = acp1_message._id\n            INNER JOIN message AS current_message\n              ON current_message._id = ?\n          WHERE\n            acp1_message.chat_row_id = current_message.chat_row_id\n            AND acp1_message.message_type = ?\n            AND acp1_message.from_me = current_message.from_me\n            AND IFNULL(acp1_message.sender_jid_row_id, -1) =\n              IFNULL(current_message.sender_jid_row_id, -1)\n            AND ABS(acp1_message.timestamp - current_message.timestamp) <= 5000\n            AND acp1.enabled = ?\n            AND acp1.trigger = ?\n          ORDER BY\n            ABS(acp1_message.timestamp - current_message.timestamp) ASC,\n            ABS(acp1_message._id - current_message._id) ASC,\n            acp1_message._id DESC\n          LIMIT 1\n        "

